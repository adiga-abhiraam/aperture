# Copy to .env at the repo root. start-local.ps1 and the backend both read it.
# Never commit the real file (.env is git-ignored).

# ---- Provider keys (backend only; never shipped to the browser) ----
GEMINI_API_KEY=
# Optional pool for automatic key rotation, e.g. ["key1","key2"]
GEMINI_API_KEYS_JSON=[]
# Only needed if you pick an OpenAI model on the public demo pages
OPENAI_API_KEY=

# ---- Vector database ----
# Local Docker Qdrant (docker compose up -d qdrant). Point at a Qdrant Cloud
# URL and set QDRANT_API_KEY to use the cloud instead.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
COLLECTION_NAME=video_windows

# ---- Backend ----
PORT=8000
PUBLIC_LAUNCH_MODE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Model used by the "Ask this video" chat (defaults to the quick-demo model)
CHAT_MODEL=gemini-3.1-flash-lite

# ---- Cloud-API processing speed knobs (defaults shown) ----
# Windows embedded in parallel; captions / transcript chunks in parallel.
API_EMBED_CONCURRENCY=6
API_CAPTION_CONCURRENCY=6
API_TRANSCRIPTION_CONCURRENCY=3
# Describe every window (1) or only scene changes (0). Every window costs one
# call per window but gives the chat a description of each moment.
API_CAPTION_ALL_WINDOWS=1
# When transcript + captions can't answer, the chat sends the video itself to
# the model. Limits keep long archives from being uploaded per question.
CHAT_VIDEO_FALLBACK_MAX_MB=200
CHAT_VIDEO_FALLBACK_MAX_MINUTES=40
# Clips sent to the embedding/caption models are downscaled; 0 keeps source.
API_CLIP_MAX_HEIGHT=360
API_CLIP_FPS=6

# ---- Frontend (Vite; only VITE_* values are exposed to the browser) ----
VITE_SEARCH_API_URL=http://127.0.0.1:8000
VITE_SITE_URL=http://127.0.0.1:3000
VITE_PUBLIC_UPLOADS_ENABLED=true

# Requests per minute each key in GEMINI_API_KEYS_JSON may send (free tier ~15). 0 = no pacing.
GEMINI_PER_KEY_RPM=12
