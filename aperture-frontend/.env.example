# Copy to .env.local to override.

# Where the FastAPI backend runs (start-local.ps1 sets this automatically).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Set to 1 to run the UI on the browser-only mock data instead of the API.
NEXT_PUBLIC_USE_MOCK=0

# Caption pipeline for new uploads: selection_only (no keys needed),
# local_qwen, openai, cosmos or mock. See processing_indexing/debug_jobs.py.
NEXT_PUBLIC_VLM_MODE=selection_only
